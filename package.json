{
  "name": "afvi-parse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:light": "node --experimental-strip-types --test tests/light-simulation.test.mjs",
    "test:teach": "node --experimental-strip-types --test teach-core/tests/*.test.ts",
    "validate:teach": "node --experimental-strip-types teach-core/scripts/validate-reference.ts",
    "teach": "node --experimental-strip-types --no-warnings teach-app/server.ts",
    "teach:native": "node teach-app/scripts/build-native.ts",
    "teach:smoke": "node --experimental-strip-types --no-warnings teach-app/scripts/smoke.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.2"
  }
}
