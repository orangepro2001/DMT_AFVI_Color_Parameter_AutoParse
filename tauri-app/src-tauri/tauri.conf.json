{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AFVI_Parse",
  "mainBinaryName": "AFVI_Parse",
  "version": "0.1.0",
  "identifier": "com.afvi.parse",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/afvi-parse/browser"
  },
  "app": {
    "windows": [
      {
        "title": "AFVI_Parse",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}